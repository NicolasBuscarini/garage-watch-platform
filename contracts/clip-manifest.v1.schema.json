{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garage-watch.local/contracts/clip-manifest.v1.schema.json",
  "title": "Selective clip manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "clipId", "cameraId", "requestedStartedAt", "requestedEndedAt", "effectiveStartedAt", "effectiveEndedAt", "state", "triggerConfigVersion", "triggerReason", "segmentIds", "mediaFileName", "mediaSha256", "thumbnailFileName", "thumbnailSha256", "attemptCount", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "clipId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "cameraId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "requestedStartedAt": { "type": "string", "format": "date-time" },
    "requestedEndedAt": { "type": "string", "format": "date-time" },
    "effectiveStartedAt": { "type": "string", "format": "date-time" },
    "effectiveEndedAt": { "type": "string", "format": "date-time" },
    "state": { "enum": ["collecting", "ready", "failed", "lost_capacity"] },
    "triggerConfigVersion": { "type": "string", "minLength": 1 },
    "triggerReason": { "type": "string", "minLength": 1 },
    "segmentIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-f0-9]{32}$" } },
    "mediaFileName": { "type": ["string", "null"] },
    "mediaSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "thumbnailFileName": { "type": ["string", "null"] },
    "thumbnailSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "attemptCount": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "archiveStatus": { "enum": ["not_requested", "pending", "copying", "verifying", "archived", "retry_wait", "failed"] },
    "archiveAttemptCount": { "type": "integer", "minimum": 0 },
    "archiveNextAttemptAt": { "type": ["string", "null"], "format": "date-time" },
    "archivedAt": { "type": ["string", "null"], "format": "date-time" },
    "archiveManifestSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
