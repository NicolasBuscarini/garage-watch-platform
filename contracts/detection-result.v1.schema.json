{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garage-watch.local/contracts/detection-result.v1.schema.json",
  "title": "DetectionResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cameraId", "streamEpoch", "frameId", "capturedAt", "processedAt", "frameWidth", "frameHeight", "modelVersion", "detections"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "cameraId": { "type": "string", "minLength": 1 },
    "streamEpoch": { "type": "string", "minLength": 1 },
    "frameId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "processedAt": { "type": "string", "format": "date-time" },
    "frameWidth": { "type": "integer", "minimum": 1 },
    "frameHeight": { "type": "integer", "minimum": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "detections": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/detection" } }
  },
  "$defs": {
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackId", "className", "classId", "score", "box"],
      "properties": {
        "trackId": { "type": "string", "minLength": 1 },
        "className": { "type": "string", "minLength": 1, "maxLength": 64 },
        "classId": { "type": "integer", "minimum": 0 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "box": { "type": "object", "additionalProperties": false, "required": ["x1", "y1", "x2", "y2"], "properties": { "x1": { "type": "number", "minimum": 0, "maximum": 1 }, "y1": { "type": "number", "minimum": 0, "maximum": 1 }, "x2": { "type": "number", "minimum": 0, "maximum": 1 }, "y2": { "type": "number", "minimum": 0, "maximum": 1 } } }
      }
    }
  }
}
