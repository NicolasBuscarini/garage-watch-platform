{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garage-watch.local/contracts/archived-clip-manifest.v1.schema.json",
  "title": "Archived clip commit manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "clipId", "publicId", "cameraId", "requestedStartedAt", "requestedEndedAt", "effectiveStartedAt", "effectiveEndedAt", "triggerConfigVersion", "triggerReason", "segmentIds", "mediaFileName", "mediaSizeBytes", "mediaSha256", "thumbnailFileName", "thumbnailSizeBytes", "thumbnailSha256", "archivedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "clipId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "publicId": { "type": "string", "pattern": "^CLP[0-9]{12}$" },
    "cameraId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "requestedStartedAt": { "type": "string", "format": "date-time" },
    "requestedEndedAt": { "type": "string", "format": "date-time" },
    "effectiveStartedAt": { "type": "string", "format": "date-time" },
    "effectiveEndedAt": { "type": "string", "format": "date-time" },
    "triggerConfigVersion": { "type": "string", "minLength": 1 },
    "triggerReason": { "type": "string", "minLength": 1 },
    "segmentIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-f0-9]{32}$" } },
    "mediaFileName": { "type": "string", "pattern": "^[a-f0-9]{32}\\.ts$" },
    "mediaSizeBytes": { "type": "integer", "minimum": 1 },
    "mediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "thumbnailFileName": { "type": "string", "pattern": "^[a-f0-9]{32}\\.jpg$" },
    "thumbnailSizeBytes": { "type": "integer", "minimum": 1 },
    "thumbnailSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "archivedAt": { "type": "string", "format": "date-time" }
  }
}
